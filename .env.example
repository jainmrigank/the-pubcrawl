# LLM for photo ingredient-identification and original-recipe drafting.
# Any OpenAI-compatible endpoint works. Without a key the app still runs:
# matching/browsing are unaffected, drafting falls back to an offline template.
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=45

# Bar nudges (web push). Generate a key pair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# PUSH_SECRET guards /api/push/send; give the same value to the GitHub Action.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
PUSH_SECRET=

# Durable likes / kept drinks / push subscriptions (free Upstash Redis).
# Without these the server writes local JSON, which resets on every redeploy.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional Umami Cloud website ID (public UUID). Enable tracking per build.
VITE_UMAMI_WEBSITE_ID=
# Public frontend build values
VITE_API_BASE=
VITE_GOOGLE_SITE_VERIFICATION=

# API runtime secrets. Set on the Worker, not in Vercel's client environment.
PUBCRAWL_BUSINESS_ADMIN_KEY=
PUBCRAWL_BUSINESS_SIGNING_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
PUBCRAWL_EMAIL_FROM=
PUBCRAWL_CONTACT_EMAIL=
PUBCRAWL_MERCHANT_NAME=
# Local override for the public offer routes. Production currently sets 0.
PUBCRAWL_PUBLIC_OFFERS=
# Optional JSON strings for approved affiliate URLs or a confirmed workshop.
PUBCRAWL_AFFILIATE_LINKS_JSON=
PUBCRAWL_WORKSHOP_JSON=
