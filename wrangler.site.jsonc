{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pubcrawl-site",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "thepubcrawl.in/*",
      "zone_name": "thepubcrawl.in"
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash"
  }
}
