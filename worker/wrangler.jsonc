{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pubcrawl-api",
  "main": "index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  // Secrets are provisioned with `wrangler secret put` and are intentionally
  // absent from this file. Required production bindings: KV_REST_API_TOKEN
  // and RATE_LIMIT_SALT (see worker/README.md).
  "vars": {
    "FRONTEND_ORIGIN": "https://the-pubcrawl.vercel.app",
    "PUSH_ENABLED": "false"
  },
  "triggers": {
    "crons": ["0 12 * * *"]
  },
  "queues": {
    "producers": [
      {
        "binding": "PUSH_DELIVERY_QUEUE",
        "queue": "pubcrawl-daily-notifications"
      }
    ],
    "consumers": [
      {
        "queue": "pubcrawl-daily-notifications",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 5
      }
    ]
  }
}
