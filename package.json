{
  "name": "the-pubcrawl",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "scrape": "node scripts/scrape.mjs",
    "videos": "node scripts/fetch_videos.mjs",
    "images": "node scripts/fetch_images.mjs",
    "dev": "vite",
    "serve": "node server/index.mjs",
    "generate:client-data": "node scripts/build_client_data.mjs --write",
    "check:client-data": "node scripts/build_client_data.mjs --check",
    "build": "npm run check:client-data && tsc -b && vite build",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:preview": "npm run build && PUBCRAWL_E2E_MODE=preview playwright test",
    "test:e2e:webkit": "npm run build && playwright test --config=playwright.webkit.config.ts",
    "worker:dry-run": "WRANGLER_LOG_PATH=/tmp/pubcrawl-wrangler.log WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config worker/wrangler.jsonc --outdir /tmp/pubcrawl-worker-dry-run",
    "test:worker": "node --experimental-strip-types --test test/worker-api.test.mjs",
    "perf:local": "node scripts/perf_probe.mjs",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^4.21.2",
    "framer-motion": "^12.42.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "wrangler": "^4.127.1"
  }
}
